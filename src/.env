# ══════════════════════════════════════════════════════════════
#  .env — À créer à la racine de ton projet React TailAdmin
# ══════════════════════════════════════════════════════════════
VITE_API_URL=http://127.0.0.1:8000/api


# ══════════════════════════════════════════════════════════════
#  GUIDE DE CONNEXION REACT ↔ API LARAVEL
# ══════════════════════════════════════════════════════════════
#
#  1. Lance l'API Laravel :
#     cd C:\xampp\htdocs\challengehub-api
#     php artisan serve
#     → http://127.0.0.1:8000
#
#  2. Lance React :
#     cd ton-projet-tailadmin
#     npm run dev
#     → http://localhost:5173
#
#  3. Connecte-toi avec :
#     Email    : mamadou@example.com
#     Password : password
#
# ══════════════════════════════════════════════════════════════
#  RÉSUMÉ DES FICHIERS À COPIER DANS TAILADMIN
# ══════════════════════════════════════════════════════════════
#
#  src/
#  ├── App.tsx                              ← remplace l'existant
#  ├── .env                                 ← créer à la racine
#  ├── services/
#  │   └── api.ts                           ← créer
#  ├── context/
#  │   └── AuthContext.tsx                  ← créer
#  ├── hooks/
#  │   └── useApi.ts                        ← créer (contient tous les hooks)
#  ├── components/common/
#  │   └── ApiComponents.tsx                ← créer (Spinner, ErrorBox, EmptyState, ProtectedRoute)
#  ├── components/auth/
#  │   ├── SignInForm.tsx                   ← remplace l'existant
#  │   └── SignUpForm.tsx                   ← remplace l'existant
#  └── pages/
#      ├── Dashboard/Home.tsx               ← remplace l'existant
#      ├── Challenges/
#      │   ├── Challenges.tsx               ← remplace l'existant
#      │   ├── ChallengeDetail.tsx          ← remplace l'existant
#      │   ├── CreerChallenge.tsx           ← remplace l'existant
#      │   └── MesChallenges.tsx            ← remplace l'existant
#      ├── Participations/
#      │   └── MesParticipations.tsx        ← remplace l'existant
#      ├── Jury/
#      │   └── EspaceJury.tsx               ← remplace l'existant
#      ├── Notifications/
#      │   └── Notifications.tsx            ← remplace l'existant
#      ├── Wallet/
#      │   └── Wallet.tsx                   ← remplace l'existant
#      └── UserProfiles.tsx                 ← remplace l'existant
#
# ══════════════════════════════════════════════════════════════
#  IMPORTANT : enregistrer AuthProvider dans main.tsx
# ══════════════════════════════════════════════════════════════
#
#  Dans src/main.tsx, App.tsx inclut déjà <AuthProvider>.
#  Aucune modification supplémentaire de main.tsx requise.
#
# ══════════════════════════════════════════════════════════════
